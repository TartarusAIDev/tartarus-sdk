{
  "name": "tartarus-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Tartarus uncensored coding API (OpenAI-compatible): chat, streaming, tool-calling.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ai", "llm", "coding-agent", "uncensored", "openai-compatible", "sdk", "tartarus"],
  "homepage": "https://tartarusai.dev",
  "repository": { "type": "git", "url": "https://github.com/TartarusAIDev/tartarus-sdk.git" },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
